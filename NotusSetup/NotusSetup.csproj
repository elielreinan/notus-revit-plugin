<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Instalador_Notus_Revit2025</AssemblyName>
    <RootNamespace>NotusSetup</RootNamespace>
    <ApplicationIcon>..\notus_logo.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\notus_logo.ico" Link="notus_logo.ico" />
    <EmbeddedResource Include="..\NotusRevitPlugin\bin\Release\net8.0-windows\NotusRevitPlugin.dll" LogicalName="Payload.NotusRevitPlugin.dll" />
    <EmbeddedResource Include="..\NotusRevitPlugin\Assets\Ribbon\*.png" LogicalName="Payload.Assets.Ribbon.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\shared_parameters\Notus_SharedParameters.txt" LogicalName="Payload.Notus_SharedParameters.txt" />
  </ItemGroup>

</Project>


